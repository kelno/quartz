FROM node:22-slim AS publisher

WORKDIR /usr/src/app

# The service runs without network, so the og-image plugin can't fetch Google Fonts for the social
# preview images; without a local font it skips them. DejaVu is the first font it falls back on.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json .npmrc ./
RUN npm ci

COPY . .

# Generate the v5 plugin module inside the image and validate the privacy-critical exporter.
# The service may run as any user, one the image doesn't know, so the folders it writes in at run
# time are writable by all: the working folder, where it replaces content/ and keeps its scratch
# folder .publisher-work, and Quartz's build caches.
RUN npm run install-plugins \
    && npm run test:publisher \
    && npm run check \
    && cp -a content base-content \
    && rm -rf public .quartz-cache .publisher-work quartz/.quartz-cache \
    && mkdir .quartz-cache .publisher-work quartz/.quartz-cache \
    && chmod a+rwx . content .quartz-cache .publisher-work quartz/.quartz-cache

ENV VAULT_DIR=/vault \
    OUTPUT_DIR=/output \
    BASE_CONTENT_DIR=/usr/src/app/base-content \
    QUARTZ_PROJECT_DIR=/usr/src/app \
    POLL_INTERVAL_SECONDS=60 \
    STABLE_SCANS=2 \
    KEEP_RELEASES=3

VOLUME ["/vault", "/output"]

CMD ["node", "scripts/publisher/service.mjs"]

