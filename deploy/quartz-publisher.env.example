# Image built from Dockerfile.publisher.
PUBLISHER_IMAGE=localhost/quartz-publisher:v5

# Existing synchronized Obsidian vault. The unit mounts this read-only.
VAULT_HOST_DIR=/srv/sync/obsidian-vault

# Persistent release directory. Configure Nginx to serve OUTPUT_HOST_DIR/current.
OUTPUT_HOST_DIR=/srv/quartz-output

# Polling avoids relying on filesystem notifications from the synchronized mount.
POLL_INTERVAL_SECONDS=60

# A candidate must be identical across this many scans before it can replace the live site.
STABLE_SCANS=2

# Directory names ignored at every depth while scanning the vault.
PUBLISH_IGNORE_DIRS=.git,.obsidian,.trash


# Folders a permalink must start with, comma-separated (for example blog,articles); each one is a
# part of the site. Empty: any plain relative permalink is accepted.
PUBLISH_PERMALINK_PREFIXES=

# This site's Quartz configuration, a copy of quartz.config.default.yaml with at least baseUrl set.
QUARTZ_CONFIG_HOST_FILE=/etc/quartz-publisher/quartz.config.yaml
